<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="QuestTrackerContainer" style="flex-grow: 1; flex-direction: column; aspect-ratio: auto; align-items: flex-start; align-self: flex-start; white-space: nowrap; background-color: rgba(0, 0, 0, 0.47); height: auto; min-height: 11%; max-height: 15%; position: absolute; -unity-font-definition: url(&quot;project://database/Assets/Fonts/The%20Natures.ttf?fileID=12800000&amp;guid=195aaa5e558f0c14e8ebbe57d868abb7&amp;type=3#The Natures&quot;); letter-spacing: 22px;">
        <ui:Label text="Fastgør en quest" name="PinnedQuestTitle" style="background-color: rgba(0, 0, 0, 0); color: rgb(255, 255, 255); font-size: 30px;"/>
