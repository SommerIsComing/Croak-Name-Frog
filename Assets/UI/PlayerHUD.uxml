    <ui:VisualElement name="InteractionContainer" style="flex-grow: 0; position: absolute; align-self: flex-start; align-content: flex-start; top: 0%; left: 0%; right: 1246px; bottom: 0%; background-image: none; -unity-background-scale-mode: scale-and-crop; aspect-ratio: auto; width: 13%; height: 9%; flex-shrink: 0; display: flex; background-color: rgba(0, 0, 0, 0.47); -unity-background-image-tint-color: rgb(255, 255, 255); background-position-x: center; background-position-y: center; align-items: flex-start; justify-content: space-around; flex-direction: row; -unity-text-align: upper-left;">
        <ui:VisualElement name="FirstInteractionIcon" style="flex-grow: 0; background-image: url(&quot;project://database/Assets/GameInputControllerIconsFree/keyboard/keyboard-solid/e.png?fileID=21300000&amp;guid=69da02ec34c73624b91727759ad616df&amp;type=3#e&quot;); width: 43%; height: 110%; align-items: flex-start; justify-content: flex-start; align-self: center; align-content: center; flex-shrink: 0;"/>
