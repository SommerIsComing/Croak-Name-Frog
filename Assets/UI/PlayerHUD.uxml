    </ui:VisualElement>
    <ui:VisualElement name="NewQuestContainer" style="flex-grow: 0; position: absolute; align-items: center; justify-content: center; align-self: center; align-content: center; flex-shrink: 0; top: 15%; width: 45%; height: auto; font-size: 46px; -unity-font-style: bold; -unity-text-align: upper-center; background-color: rgba(0, 0, 0, 0.47); -unity-font-definition: url(&quot;project://database/Assets/Fonts/The%20Natures.ttf?fileID=12800000&amp;guid=195aaa5e558f0c14e8ebbe57d868abb7&amp;type=3#The Natures&quot;);">
        <ui:Label text="Ny Quest Tilgængelig!" name="NewQuestText" style="background-color: rgba(0, 0, 0, 0); color: rgb(229, 217, 217);"/>
        <ui:Label text="Label" name="NewQuestNameText" style="color: rgb(255, 255, 255); -unity-font-style: bold-and-italic; font-size: 30px;"/>
    </ui:VisualElement>
    <ui:VisualElement name="CompletedQuestContainer" style="flex-grow: 0; position: absolute; align-items: center; justify-content: center; align-self: center; align-content: center; flex-shrink: 0; top: 15%; width: 45%; height: auto; font-size: 46px; -unity-font-style: bold; -unity-text-align: upper-center; background-color: rgba(0, 0, 0, 0.47); -unity-font-definition: url(&quot;project://database/Assets/Fonts/The%20Natures.ttf?fileID=12800000&amp;guid=195aaa5e558f0c14e8ebbe57d868abb7&amp;type=3#The Natures&quot;);">
        <ui:Label text="Quest Fuldført!" name="CompletedQuestText" style="background-color: rgba(0, 0, 0, 0); color: rgb(229, 217, 217);"/>
